NODE_ENV=development
PORT=3000
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>/<database>
# Chuỗi ngẫu nhiên dài, tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời hạn token khi chọn "Remember me" / khi không chọn
JWT_TTL_REMEMBER=30d
JWT_TTL=1d
