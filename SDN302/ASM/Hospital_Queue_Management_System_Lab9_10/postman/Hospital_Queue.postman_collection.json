    {
      "name": "02. Departments",
      "description": "Lấy danh sách khoa và tự lưu _id của CARD, ORTH, DERM, NEUR.",
      "item": [
        {
          "name": "Get all departments (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.response.json().data.forEach((d) => {",
                  "    if ([\"CARD\", \"ORTH\", \"DERM\", \"NEUR\"].includes(d.deptCode)) pm.collectionVariables.set(\"dept\" + d.deptCode, d._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{receptionistToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "departments"
              ]
            }
          }
        }
