  "item": [
    {
      "name": "01. Auth",
      "description": "Đăng ký / đăng nhập. Login doctor & receptionist sẽ tự lưu token.",
      "item": [
        {
          "name": "Register - Success (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUsername\", \"receptionist_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Default role is receptionist\", () => pm.expect(pm.response.json().data.role).to.eql(\"receptionist\"));",
                  "pm.test(\"Password is not returned\", () => pm.expect(pm.response.json().data.password).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{newUsername}}\",\n    \"password\": \"123456\",\n    \"fullName\": \"Le Van Test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
