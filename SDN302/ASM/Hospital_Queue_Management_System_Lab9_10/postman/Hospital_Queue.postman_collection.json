                  "const token = pm.response.json().data.token;",
                  "pm.collectionVariables.set(\"doctorToken\", token);",
                  "const payload = JSON.parse(atob(token.split(\".\")[1]));",
                  "pm.test(\"Token has userId, role, fullName\", () => pm.expect(payload).to.include.keys(\"userId\", \"role\", \"fullName\"));"
                ]
